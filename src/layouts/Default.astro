---
interface Props {
  title?: string;
}

const { title = "Addie's Art Show" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Addie's Art Show — custom cartoon commissions" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 min-h-screen">
    <div class="container mx-auto px-4 py-8 max-w-4xl">
      <h1 class="text-4xl font-bold text-center mb-6">Addie's Art Show</h1>

      <nav class="flex justify-center gap-8 mb-10 text-lg font-semibold">
        <a href="/" class="hover:text-gray-500 transition-colors">Home</a>
        <a href="/about" class="hover:text-gray-500 transition-colors">About</a>
        <a href="/contact" class="hover:text-gray-500 transition-colors">Contact</a>
      </nav>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
